{
  "name": "@accessible-ecosystem/core",
  "version": "1.0.0-beta.0",
  "description": "The core for all accessible components.",
  "homepage": "https://github.com/Accessible-Ecosystem/core#readme",
  "bugs": {
    "url": "https://github.com/Accessible-Ecosystem/core/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Accessible-Ecosystem/core.git"
  },
  "license": "GPL-3.0-or-later",
  "author": "Nick Milton",
  "type": "module",
  "main": "src/Component.js",
  "files": [
    "src"
  ],
  "exports": {
    ".": {
      "import": "./src/Component.js"
    },
    "./*": {
      "import": "./src/*"
    }
  },
  "scripts": {
    "prepare": "husky",
    "commit": "git cz",
    "eslint": "eslint .",
    "prettier": "prettier '**/*.{js,mjs,cjs,scss,sass}'",
    "lint": "npm run eslint -- --fix && npm run prettier --  --write",
    "release": "commit-and-tag-version -a",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:run": "vitest run",
    "test:unit": "vitest run unit"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.2.1",
    "@commitlint/config-conventional": "^19.1.0",
    "@eslint/js": "^9.0.0",
    "@vitest/ui": "^4.0.16",
    "chokidar-cli": "^3.0.0",
    "commit-and-tag-version": "^12.5.1",
    "commitizen": "^4.3.0",
    "cz-conventional-changelog": "^3.3.0",
    "eslint": "^9.11.1",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-jsdoc": "^50.2.4",
    "globals": "^15.0.0",
    "husky": "^9.0.11",
    "jsdom": "^27.4.0",
    "lint-staged": "^15.2.2",
    "prettier": "^3.2.5",
    "vite": "^8.0.14",
    "vitest": "^4.0.16",
    "vitest-axe": "^0.1.0"
  }
}
